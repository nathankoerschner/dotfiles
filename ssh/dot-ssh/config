# Shared SSH config (stowed from dotfiles). Machine-specific hosts go in ~/.ssh/config.local.
Include ~/.ssh/config.local

# ag: primary dev Mac (agents, repos, Herdr). Tailscale IP.
Host ag
    HostName 100.107.192.32
    User natkoersch
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 15
    ServerAliveCountMax 3
    # Reuse one connection (instant Cmd+V image paste, shot/show). Socket dir: ~/.ssh/sockets.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h

# ag-mac: the Mac half of Ag (today still named `ag`). The engine reaches it with its own key
# (~/.ssh/ag-mac, from ag-vault "ag-engine → ag-mac SSH key"; authorized on ag-mac only from tailnet IPs).
# Used by `mac` (Mac-only commands, computer use, files) and the engine's MCP tunnel.
Host ag-mac
    HostName 100.107.192.32
    User natkoersch
    IdentityFile ~/.ssh/ag-mac
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h

# Client Mac (where Nathan sits). ag uses this for shot/show/client-cua.
Host nathan-dev-client
    HostName 100.68.116.104
    User nathan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h

# Ag engine (Hetzner, rebuilt by ag-infra; Tailscale IP changes on rebuild, so use MagicDNS).
Host ag-engine
    HostName ag-engine.tail44736d.ts.net
    User nathan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 4h
