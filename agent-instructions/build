#!/usr/bin/env bash
# Assemble the global agent instructions (pi/dot-pi/agent/AGENTS.md) from
# AGENTS.template.md. A line `<!-- include: NAME.md -->` is replaced by that file
# from this directory, with its headings demoted two levels so they nest under the
# template's `##` section.
#   build          write the generated file
#   build --check  exit 1 if the generated file is out of date
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
out="$here/../pi/dot-pi/agent/AGENTS.md"

render() {
  printf '<!-- GENERATED by agent-instructions/build from agent-instructions/AGENTS.template.md. Do not edit; edit the sources and rebuild. -->\n\n'
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^\<!--\ include:\ ([A-Za-z0-9._-]+)\ --\>$ ]]; then
      src="$here/${BASH_REMATCH[1]}"
      [[ -f $src ]] || { echo "build: missing include $src" >&2; exit 1; }
      awk '/^```/ { fence = !fence } !fence && /^#/ { $0 = "##" $0 } { print }' "$src"
    else
      printf '%s\n' "$line"
    fi
  done < "$here/AGENTS.template.md"
}

if [[ ${1:-} == --check ]]; then
  diff -q <(render) "$out" >/dev/null || { echo "build: $out is stale; run agent-instructions/build" >&2; exit 1; }
else
  render > "$out"
fi
